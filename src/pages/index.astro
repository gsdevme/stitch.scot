---
/**
 * "Postcard" homepage: one full-bleed photo of Stitch with his name set large
 * across the top left, a one-line introduction and, at the bottom, a link to
 * his Instagram.
 * `/info` is deliberately not linked from here: it is reachable by URL only.
 *
 * The hero is `src/assets/stitch-hero.jpg`. The layout is fitted to that
 * photo: Stitch fills the lower two thirds, left of centre, under a band of
 * dark sea. The name is capped by viewport height so it stays inside that band
 * above his ears, and `object-position` keeps him in frame when a tall
 * viewport crops the sides. A replacement photo with the subject elsewhere
 * needs the `.name` size and `.photo` position revisiting.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/stitch-hero.jpg';
import Age from '../components/Age.astro';
import { ageInYears, numberInWords, stitch } from '../data/handover';

const intro = `${stitch.breed}. ${numberInWords(ageInYears(stitch.dateOfBirth))} years old. ${stitch.home}.`;
---

<Base title={`${stitch.name} · ${stitch.breed}`} description={`${stitch.name}: ${intro}`}>
  <main class="postcard">
    <Image
      class="photo"
      src={hero}
      alt={`${stitch.name} the ${stitch.breed}`}
      widths={[640, 960, 1280, 1600, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="caption">
      <header>
        <h1 class="name">{stitch.name}</h1>
        <p class="intro">{stitch.breed}. <Age format="words" /> years old. {stitch.home}.</p>
      </header>
      <nav class="actions" aria-label="Links">
        <a class="button button--solid" href={stitch.instagram.url} rel="me noopener">
          Instagram
        </a>
      </nav>
    </div>
  </main>
</Base>

<style>
  .postcard {
    position: relative;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
    background: #2b2a27;
    color: #fff;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 27% center;
  }

  .postcard::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0) 42%),
      linear-gradient(to top, rgb(0 0 0 / 0.4) 0%, rgb(0 0 0 / 0) 28%);
    pointer-events: none;
  }

  .caption {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: clamp(1.25rem, 5vw, 4rem);
    padding-bottom: max(clamp(1.5rem, 6vw, 4.5rem), env(safe-area-inset-bottom));
  }

  .name {
    margin: 0;
    font-size: clamp(4rem, min(21vw, 16svh), 17rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
  }

  .intro {
    margin: clamp(0.75rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    font-weight: 500;
    max-width: 40ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.75rem;
    border: 2px solid #fff;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .button--solid {
    background: #fff;
    color: #111;
  }

  .button--solid:hover {
    background: transparent;
    color: #fff;
  }

  @media (max-width: 34rem) {
    .actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
