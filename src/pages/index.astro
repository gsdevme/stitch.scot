---
/**
 * "Postcard" homepage: one full-bleed photo of Stitch with his name set large
 * over the lower left, a one-line introduction and two links.
 *
 * The hero is `src/assets/stitch-hero.jpg`; replacing that one file with a
 * real photo is all it takes to change the picture.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/stitch-hero.jpg';
import { numberInWords, stitch } from '../data/handover';

const intro = `${stitch.breed}. ${numberInWords(stitch.ageYears)} years old. ${stitch.home}.`;
---

<Base title={`${stitch.name} · ${stitch.breed}`} description={`${stitch.name}: ${intro}`}>
  <main class="postcard">
    <Image
      class="photo"
      src={hero}
      alt={`${stitch.name} the ${stitch.breed}`}
      widths={[640, 960, 1280, 1600, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="caption">
      <h1 class="name">{stitch.name}</h1>
      <p class="intro">{intro}</p>
      <nav class="actions" aria-label="Links">
        <a class="button button--solid" href={stitch.instagram.url} rel="me noopener">
          Instagram
        </a>
        <a class="button button--outline" href="/walker">Walker sheet</a>
      </nav>
    </div>
  </main>
</Base>

<style>
  .postcard {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #2b2a27;
    color: #fff;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .postcard::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.78) 0%,
      rgb(0 0 0 / 0.45) 35%,
      rgb(0 0 0 / 0) 65%
    );
    pointer-events: none;
  }

  .caption {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: clamp(1.25rem, 5vw, 4rem);
    padding-bottom: max(clamp(1.5rem, 6vw, 4.5rem), env(safe-area-inset-bottom));
  }

  .name {
    margin: 0;
    font-size: clamp(4.5rem, 21vw, 17rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
  }

  .intro {
    margin: clamp(0.75rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    font-weight: 500;
    max-width: 40ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.75rem;
    border: 2px solid #fff;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .button--solid {
    background: #fff;
    color: #111;
  }

  .button--solid:hover {
    background: transparent;
    color: #fff;
  }

  .button--outline {
    color: #fff;
  }

  .button--outline:hover {
    background: #fff;
    color: #111;
  }

  @media (max-width: 34rem) {
    .actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
